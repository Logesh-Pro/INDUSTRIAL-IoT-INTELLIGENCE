# MQTT
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=industrial/site01/zone01/telemetry
MQTT_CLIENT_ID=iiot_backend
MQTT_STATUS_TOPIC=industrial/site01/zone01/status
MQTT_EVENTS_TOPIC=industrial/site01/zone01/events

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=REPLACE_WITH_YOUR_INFLUXDB_TOKEN
INFLUX_ORG=industrial_iot
INFLUX_BUCKET=telemetry

# API
API_HOST=127.0.0.1
API_PORT=5000

# Reliability
ENVIRONMENT=development
LOG_LEVEL=INFO
DEVICE_OFFLINE_TIMEOUT_SECONDS=15
DEVICE_HEALTH_CHECK_INTERVAL_SECONDS=5
